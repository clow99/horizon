{
  "name": "horizon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathIgnorePatterns=integration,e2e",
    "test:integration": "jest tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test && npm run test:e2e",
    "build": "next build",
    "build:fast": "next build",
    "start": "next start",
    "lint": "eslint",
    "migrate": "node scripts/migrate-add-user-id.js",
    "migrate:archive": "node scripts/add-archived-column.js"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "mysql2": "^3.24.6",
    "next": "15.5.29",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "uuid": "^13.0.2"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.25.9",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "autoprefixer": "^10.4.21",
    "babel-jest": "^29.7.0",
    "better-sqlite3": "^11.7.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "jest": "^29.7.0",
    "jest-config": "^30.2.0",
    "jest-environment-jsdom": "^29.7.0",
    "playwright": "^1.49.0",
    "tailwindcss": "^4",
    "typescript": "5.9.3"
  },
  "overrides": {
    "sharp": "0.35.5",
    "postcss": "8.5.32"
  }
}
